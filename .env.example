# ============================================================================
# ESTATESPHERE SOVEREIGN SINGLE-VPS CONFIGURATION (.env.example)
# Copy to .env for local or Hostinger KVM VPS deployment
# ============================================================================

PORT=3000
NODE_ENV=production

# Option A: Solopreneur Master Key & Strict Edge Enforcement
SOLO_ADMIN_KEY=estatesphere-solo-2026
STRICT_AUTH=false

# Single-VPS Sovereign Persistence (PocketBase SQLite + MinIO S3)
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_TOKEN=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=estatesphere-media
MINIO_ROOT_USER=estatesphere
MINIO_ROOT_PASSWORD=estatesphere-sovereign-storage

# Option C: Sovereign Local/VPS LLM Routing (Ollama / LiteLLM / LM Studio)
LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Lead Notification Webhook (Activepieces / n8n / Twenty CRM / Telegram)
CRM_WEBHOOK_URL=
